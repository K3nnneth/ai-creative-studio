# Copy to .env.local. Keep real credentials out of this example.
# Supabase: project Connect dialog and Settings > API Keys.
# Server-only access for the single demo workspace.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# fal.ai: https://fal.ai/dashboard/keys
# Server-only; never use a NEXT_PUBLIC_ prefix for secret keys.
FAL_KEY=

# Research: Firecrawl (selected from the brief's permitted services).
FIRECRAWL_API_KEY=

# LLM access: Vercel AI Gateway (recommended in the brief).
AI_GATEWAY_API_KEY=
# Select a Gateway model ID during integration.
AI_PROVIDER=vercel-gateway
# Optional override. The app defaults to a fast Gateway model for brand analysis.
AI_MODEL=inclusionai/ling-3.0-flash-vl-free
